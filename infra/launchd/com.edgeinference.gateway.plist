<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.edgeinference.gateway</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/opt/node@24/bin/node</string>
        <string>/path/to/EdgeInference/dist/gateway/src/main.js</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/path/to/EdgeInference</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/opt/node@24/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
        <key>NODE_ENV</key>
        <string>production</string>
        <key>PORT</key>
        <string>8765</string>
        <key>HOST</key>
        <string>127.0.0.1</string>
        <key>DATABASE_PATH</key>
        <string>/path/to/EdgeInference/data/gateway.db</string>
    </dict>

    <!-- KeepAlive with bounded restart throttling -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
        <key>Crashed</key>
        <true/>
    </dict>

    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>/path/to/EdgeInference/data/gateway.log</string>

    <key>StandardErrorPath</key>
    <string>/path/to/EdgeInference/data/gateway-error.log</string>
</dict>
</plist>

