# EdgeInference Gateway Configuration
NODE_ENV=development
PORT=8765
HOST=127.0.0.1

# Security / Authentication
# Cryptographically random hex secret (e.g. openssl rand -hex 32)
LLM_API_SECRET=replace_with_64_char_hex_random_secret

# Ollama Upstream
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.8:27b

# Resource Limits
MAX_ACTIVE_INFERENCE=1
MAX_QUEUE_CAPACITY=2
DAILY_REQUEST_QUOTA=100
MAX_BODY_BYTES=12582912
MAX_IMAGE_BYTES=4194304
MAX_IMAGE_COUNT=2
MAX_IMAGE_MEGAPIXELS=20
MAX_PROMPT_CHARS=32000
MAX_OUTPUT_TOKENS=4096

# Persistence
DATABASE_PATH=./data/gateway.db

